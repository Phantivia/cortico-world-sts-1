{
  "name": "cortico-world-sts-1",
  "version": "0.2.0",
  "type": "module",
  "description": "Slay the Spire World for Cortico with a Mod sidecar and an in-game cursor",
  "author": "Phantivia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phantivia/cortico-world-sts-1.git"
  },
  "homepage": "https://github.com/Phantivia/cortico-world-sts-1#readme",
  "bugs": {
    "url": "https://github.com/Phantivia/cortico-world-sts-1/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "slay-the-spire"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "describe": "describe.json"
  },
  "files": [
    "src",
    "mod",
    "scripts",
    "docs",
    "describe.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:mod": "node scripts/build-mod.mjs",
    "install:mod": "node scripts/install-mod.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
